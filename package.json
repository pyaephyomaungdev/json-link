{
  "name": "json-link",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:build": "tsc -p mcp/tsconfig.json",
    "mcp:start": "node mcp/dist/index.js",
    "plugin:copy-client": "mkdir -p packages/vite-plugin/client && cp -r dist/* packages/vite-plugin/client/",
    "plugin:build": "tsc -p packages/vite-plugin/tsconfig.json && npm run plugin:copy-client",
    "plugin:test": "vitest run packages/vite-plugin",
    "create:build": "tsc -p packages/create-jsonlink/tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
