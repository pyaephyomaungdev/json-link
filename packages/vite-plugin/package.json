{
  "name": "@jsonlink/vite-plugin",
  "version": "1.0.1",
  "description": "Official JSON Link Vite Plugin & CLI for local development dashboard and two-way file synchronization",
  "author": "Pyae Phyo Maung",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "jsonlink": "bin/json-link.js",
    "json-link": "bin/json-link.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pyaephyomaungdev/json-link.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist",
    "client",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "jsonlink",
    "json-link",
    "i18n",
    "localization",
    "translation",
    "devtools",
    "myanmar"
  ]
}
